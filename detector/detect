#!/bin/sh

set -u

DETECT_THRESHOLD=10
DETECT_CONFIRMED_WEIGHT=10
DETECT_SUSPECT_WEIGHT=1
detect_point=0
detector_positive=0

SCRIPT_DIR=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
BIN_DIR=${DETECTOR_BIN_DIR:-$SCRIPT_DIR}

if [ "${DETECTOR_SKIP_BUILD:-0}" != "1" ]; then
    cd "$SCRIPT_DIR" || exit 2
    make -s persistence_detector process_detector syscall_hook_check || exit 2
fi

run_detector()
{
    label=$1
    program=$2

    score=$("$program" --score)
    status=$?

    case "$status" in
        0) ;;
        1) detector_positive=1 ;;
        *)
            echo "detector: $label check failed with status $status" >&2
            exit "$status"
            ;;
    esac

    case "$score" in
        ''|*[!0-9]*)
            echo "detector: $label check returned an invalid risk score" >&2
            exit 2
            ;;
    esac

    detect_point=$((detect_point + score))
}

run_detector persistence "$BIN_DIR/persistence_detector"
run_detector process "$BIN_DIR/process_detector"
run_detector syscall-hooks "$BIN_DIR/syscall_hook_check"

# The kernel-module evidence comes from detect.sh, which speaks the DETECTOR
# line contract instead of --score. Fold its summary into the same accumulator:
# one confirmed finding is worth the whole threshold, suspects have to stack up.
run_script_detector()
{
    label=$1
    script=$2

    if ! out=$(sh "$script" -q); then
        echo "detector: $label check failed" >&2
        exit 2
    fi

    confirmed=$(printf '%s\n' "$out" |
        sed -n 's/.*confirmed=\([0-9][0-9]*\).*/\1/p' | tail -n 1)
    suspect=$(printf '%s\n' "$out" |
        sed -n 's/.*suspect=\([0-9][0-9]*\).*/\1/p' | tail -n 1)

    case "$confirmed" in
        ''|*[!0-9]*)
            echo "detector: $label check returned no usable confirmed count" >&2
            exit 2
            ;;
    esac
    case "$suspect" in
        ''|*[!0-9]*)
            echo "detector: $label check returned no usable suspect count" >&2
            exit 2
            ;;
    esac

    [ "$confirmed" -gt 0 ] && detector_positive=1
    detect_point=$((detect_point + confirmed * DETECT_CONFIRMED_WEIGHT +
        suspect * DETECT_SUSPECT_WEIGHT))
}

if [ "$(uname -s)" = "FreeBSD" ] && command -v kldstat >/dev/null 2>&1 &&
    [ -f "$SCRIPT_DIR/detect.sh" ] && [ "${DETECTOR_SKIP_SCRIPT_CHECKS:-0}" != "1" ]; then
    run_script_detector kernel-modules "$SCRIPT_DIR/detect.sh"
fi

if [ "$detector_positive" -eq 1 ] ||
    [ "$detect_point" -ge "$DETECT_THRESHOLD" ]; then
    exit 1
fi

exit 0
