#!/bin/sh

# Packs detection.tar -- the second half of the submission:
#
#     give cs6447 rootkit writeup.md rootkit.tar detection.tar
#
# The archive unpacks to a flat directory whose entry point is ./detect, the
# same way rootkit.tar unpacks to ./install.  That is why the contents are
# staged out of detector/ instead of shipping the directory itself: the grader
# runs ./detect, not ./detector/detect.
#
# Build products from an in-tree `make` and `make kmod` are stripped, for the
# same reason as in create_submission_tarball: kernel/machine, kernel/x86 and
# kernel/i386 are absolute symlinks into /usr/src/sys and would point at the
# wrong tree (or nowhere) on the grader's machine, vnode_if*.h and
# opt_global.h are regenerated by kmod.mk, and a binary compiled here is at
# best noise for someone who has to run `make` themselves.

set -eu

HERE=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
REPO=$(CDPATH= cd -P "$HERE/.." && pwd)
SRC="$REPO/detector"

[ -d "$SRC" ] ||
    { echo "detection: no detector tree at $SRC" >&2; exit 1; }
[ -f "$SRC/detect" ] ||
    { echo "detection: missing entry point $SRC/detect" >&2; exit 1; }
[ -f "$SRC/Makefile" ] ||
    { echo "detection: missing $SRC/Makefile" >&2; exit 1; }

OUT="$REPO/detection.tar"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

# Flat copy: detector/* lands at the top of the archive.
cp -R "$SRC"/. "$STAGE"/

rm -f "$STAGE"/persistence_detector "$STAGE"/process_detector \
      "$STAGE"/syscall_hook_check "$STAGE"/port_hide
[ -d "$STAGE/kmod" ] && (
    cd "$STAGE/kmod" &&
    rm -rf machine x86 i386 &&
    rm -f .depend* export_syms vnode_if*.h opt_global.h *.o *.ko
)

# A CRLF here turns "#!/bin/sh" into "#!/bin/sh^M" and the first run dies with
# "not found".  core.autocrlf is true on the development machine, so check
# instead of assuming.
for f in detect detect.sh demo.sh Makefile kmod/Makefile syscall_check/syscall_hook_check; do
    [ -f "$STAGE/$f" ] || continue
    if LC_ALL=C grep -q "$(printf '\r')" "$STAGE/$f"; then
        echo "detection: CRLF line endings in $f" >&2
        echo "           fix: git add --renormalize . && git checkout -- ." >&2
        exit 1
    fi
done

# Normalise modes: tree copies picked up over a shared folder arrive as 0770,
# and the grader may unpack as another user.  Sources stay readable, the three
# scripts stay executable.
chmod -R a+rX,go-w "$STAGE"
chmod 755 "$STAGE"/detect "$STAGE"/detect.sh "$STAGE"/demo.sh
[ -f "$STAGE"/syscall_check/syscall_hook_check ] &&
    chmod 755 "$STAGE"/syscall_check/syscall_hook_check

(cd "$STAGE" && tar -cf "$OUT" .)

echo "detection.tar: $(tar -tf "$OUT" | wc -l | tr -d ' ') entries -> $OUT"
