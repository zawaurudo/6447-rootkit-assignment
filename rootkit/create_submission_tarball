#!/bin/sh

# Packs the archive the grader expects: install, elevate, log and remote must
# sit at the top level and stay executable inside the archive, because it runs
# them as ./install, ./elevate, ./log and ./remote.
#
# Everything else that ships is source and documentation: kernel/ (the module
# plus log.c), user/ (elevate and hide_kld built by install) and logsrc/ (the
# collector and the sender behind ./log and rklog).
#
# There used to be a second module, hiding/hiding.c, plus install_hiding to
# load it. It registered the same SYSCALL_MODULE names as rootkit.ko and
# patched the same sysent slot, so loading both gave
#   Module sys/kld_hiding failed to register: 17
# and the second hook silently overwrote the first, losing the file hiding the
# main module had installed. Nothing in install ever loaded it, so it is gone.
#
# Build artifacts from an in-tree `make` are stripped from the copy:
# kernel/machine, kernel/x86 and kernel/i386 are absolute symlinks into
# /usr/src/sys and would point at the wrong tree (or nowhere) on the grader's
# machine, the generated vnode_if*.h files are rebuilt by kmod.mk anyway, and
# a binary compiled on this box is at best noise for someone who has to run
# `make` themselves.

set -eu

HERE=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
REPO=$(CDPATH= cd -P "$HERE/.." && pwd)
cd "$HERE"

for entry in install elevate log remote; do
    [ -f "$entry" ] || { echo "missing entry point: $entry" >&2; exit 1; }
    chmod 755 "$entry"
done

OUT="$HERE/rootkit.tar"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

# Shipped from rootkit/
FILES="install uninstall elevate log remote remote.c kernel user logsrc"

# Nothing is copied from the repository root.  The submission is
# `give cs6447 rootkit writeup.md rootkit.tar detection.tar`: the detector tree
# ships as detection.tar (create_detection_tarball), and writeup.md is handed
# in on its own.  An earlier version copied detector/ and both markdown files
# in here, which is neither required nor harmless -- the archive is supposed to
# contain the rootkit.
EXTRA=""

LIST=""
for path in $FILES; do
    [ -e "$path" ] || continue
    cp -R "$path" "$STAGE/"
    LIST="$LIST $path"
done

for path in $EXTRA; do
    [ -e "$REPO/$path" ] ||
        { echo "missing from the repository root: $path" >&2; exit 1; }
    cp -R "$REPO/$path" "$STAGE/"
    LIST="$LIST $path"
done

for dir in kernel; do
    [ -d "$STAGE/$dir" ] || continue
    rm -rf "$STAGE/$dir/machine" "$STAGE/$dir/x86" "$STAGE/$dir/i386"
    rm -f "$STAGE/$dir"/*.o "$STAGE/$dir"/*.ko "$STAGE/$dir"/.depend* \
          "$STAGE/$dir"/vnode_if*.h "$STAGE/$dir"/export_syms \
          "$STAGE/$dir"/opt_global.h
done

# Programs that `install` builds on the target must not be shipped pre-compiled.
rm -f "$STAGE"/kernel/revshell "$STAGE"/user/elevate "$STAGE"/user/hide_kld

# A CRLF here turns "#!/bin/sh" into "#!/bin/sh^M" and the grader's first
# command dies with "not found". core.autocrlf is true on the development
# machine, so check instead of assuming.
for f in install uninstall elevate log remote create_submission_tarball \
         detector/detect detector/detect.sh detector/demo.sh; do
    [ -f "$STAGE/$f" ] || continue
    if LC_ALL=C grep -q "$(printf '\r')" "$STAGE/$f"; then
        echo "tarball: CRLF line endings in $f" >&2
        echo "         fix: git add --renormalize . && git checkout -- ." >&2
        exit 1
    fi
done

# Normalise modes: tree copies picked up over a shared folder arrive as 0770,
# and the grader may unpack as another user. Sources must stay readable and the
# four entry points must stay executable inside the archive.
chmod -R a+rX,go-w "$STAGE"
chmod 755 "$STAGE"/install "$STAGE"/uninstall "$STAGE"/elevate \
    "$STAGE"/log "$STAGE"/remote

# shellcheck disable=SC2086  # LIST is a deliberate word list
( cd "$STAGE" && tar -cvf "$OUT" $LIST )
